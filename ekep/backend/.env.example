# Copy to .env (either here in backend/ or one level up in ekep/ -- app/config.py reads ekep/.env first,
# then backend/.env). Placeholder values only. Never commit a real .env.

# --- LLM (OpenAI-compatible; default api.openai.com) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-key-here
# OPENAI_BASE_URL=                 # leave empty for api.openai.com; or an OpenAI-compatible gateway
INTERVIEWER_MODEL=gpt-4o
ANALYST_MODEL=gpt-4o
PLANNER_MODEL=gpt-4o
LLM_JSON_MODE=schema
LLM_MAX_TOKENS=4096

# --- Voice: browser = Web Speech API in Chrome/Edge (no extra key) | openai | gemini ---
VOICE_ENGINE=browser
# STT_ENGINE=openai                # optional overrides of VOICE_ENGINE
# TTS_ENGINE=browser
# GEMINI_API_KEY=your-gemini-key-here   # only for VOICE_ENGINE=gemini
INTERVIEW_LANGUAGE=de

# --- Knowledge search / RAG service (rag-service on port 8001) ---
KNOWLEDGE_SEARCH_PROVIDER=rag_service   # local | http | rag_service | off
SEARCH_TOP_K=3
SEARCH_MIN_SCORE=0.35
RAG_SERVICE_URL=http://localhost:8001
RAG_SERVICE_LANG=de
RAG_SERVICE_TOPIC=

# --- Privacy ---
AUDIO_RETENTION=none
PII_REDACTION=true
EXPORT_INCLUDE_EXPERT_NAME=false
CONSENT_TEXT_VERSION=2026-11-v1

# --- Access ---
AUTH_MODE=demo
EXPORT_API_KEY=change-me-rag-team-key
MAX_FOLLOWUPS_PER_TOPIC=6

# --- Database: SQLite by default (backend/data/ekep.db is created automatically) ---
# DATABASE_URL=sqlite:///./data/ekep.db
