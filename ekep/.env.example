# --- LLM: Fragen, Planung, Analyse (OpenAI) ---
LLM_PROVIDER=openai
# OPENAI_BASE_URL=               # leer lassen bzw. auskommentiert = api.openai.com
OPENAI_API_KEY=sk-...              # OpenAI-Key – NIE committen oder teilen
INTERVIEWER_MODEL=gpt-4o
ANALYST_MODEL=gpt-4o
PLANNER_MODEL=gpt-4o
LLM_JSON_MODE=schema
LLM_MAX_TOKENS=4096

# Alternative: hIP-Gateway (hessian.AI)
# OPENAI_BASE_URL=https://hip-gw.hessian.ai/v1
# OPENAI_API_KEY=sk-bf-...
# INTERVIEWER_MODEL=hIP_1.0-Gemma/gemma-4-31B-it
# ANALYST_MODEL=hIP_1.0-Mistral/Mistral-Medium-3.5-128B
# PLANNER_MODEL=hIP_1.0-Mistral/Mistral-Medium-3.5-128B
# LLM_DISABLE_THINKING=true

# --- Sprache: Speech-to-Text + Text-to-Speech ---
#   gemini  = Google Gemini, serverseitig (Key bleibt im Backend)
#   browser = Web Speech API in Chrome/Edge
#   openai  = OpenAI STT/TTS
VOICE_ENGINE=gemini
# Getrennt einstellbar (überschreibt VOICE_ENGINE). Empfehlung bei instabilem Netz:
#   STT_ENGINE=openai   → Spracherkennung serverseitig über OpenAI (gpt-4o-transcribe, Fallback whisper-1)
#   TTS_ENGINE=browser  → Vorlesen lokal mit der Windows-/Systemstimme, kein Netz nötig
# STT_ENGINE=openai
# TTS_ENGINE=browser
GEMINI_API_KEY=AIza...             # Gemini-Key – NIE ins Frontend
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore              # z. B. Kore, Puck, Charon, Fenrir, Aoede
INTERVIEW_LANGUAGE=de
# nur bei VOICE_ENGINE=openai:
STT_MODEL=gpt-4o-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# --- Wissensabgleich (Vektorsuche gegen bestehende Wissensbasis) ---
#   local = semantische Suche im Speicher über seed/reference_knowledge.json (fiktiv) + bestätigte Einheiten
#   http  = Search-Endpunkt der Vektordatenbank (Vertrag: docs/05-knowledge-search.md)
#   off   = aus
KNOWLEDGE_SEARCH_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small   # bei hIP: google-embeddinggemma/embeddinggemma-2
# EMBEDDING_BASE_URL=                    # leer = wie LLM (OpenAI); für hIP: https://hip-gw.hessian.ai/v1
# EMBEDDING_API_KEY=                     # leer = OPENAI_API_KEY
# VECTOR_SEARCH_URL=https://<rag-service>/search
# VECTOR_SEARCH_API_KEY=
# VECTOR_SEARCH_FILTERS={}
SEARCH_TOP_K=3
SEARCH_MIN_SCORE=0.35

# --- Externer RAG-Service (Wissensbasis mit zeitlicher Gültigkeit) ---
#   leer/auskommentiert = aus (Verhalten unverändert). Gesetzt = Fragevorschläge + Belege im Interviewer-Kontext,
#   jede Expertenantwort wird als Fakt eingereicht (kb_verdict). Suche darüber: KNOWLEDGE_SEARCH_PROVIDER=rag_service
# RAG_SERVICE_URL=http://localhost:8001
# RAG_SERVICE_LANG=de                    # de | en
# RAG_SERVICE_TOPIC=                     # leer = Interviewtitel

# --- Datenschutz ---
AUDIO_RETENTION=none           # none = nur im Speicher transkribieren (Default) | store
PII_REDACTION=true
EXPORT_INCLUDE_EXPERT_NAME=false
CONSENT_TEXT_VERSION=2026-11-v1

# --- Zugriff ---
AUTH_MODE=demo                 # demo = Rollen-Header aus der UI; Produktion: Entra ID (OIDC)
EXPORT_API_KEY=bitte-aendern-rag-team-key
MAX_FOLLOWUPS_PER_TOPIC=6
